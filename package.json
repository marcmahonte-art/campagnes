{
  "name": "campagnes",
  "version": "0.1.0",
  "private": true,
  "description": "Campagnes — plateforme de cadres visuels pour les organisations francophones. Phase A : socle + compte createur.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:shapes": "tsc -p tools/shape-check/tsconfig.json && node tools/shape-check/run.js",
    "check:text": "tsc -p tools/text-check/tsconfig.json && node tools/text-check/build/tools/text-check/check-text.js",
    "check:text-geometry": "tsc -p tools/text-geometry-check/tsconfig.json && node tools/text-geometry-check/run.js",
    "check:participant": "tsc -p tools/participant-check/tsconfig.json && node tools/participant-check/build/tools/participant-check/check-participant.js",
    "check:history": "tsc -p tools/history-check/tsconfig.json && node tools/history-check/build/tools/history-check/check-history.js",
    "check:watermark": "tsc -p tools/watermark-check/tsconfig.json && node -r ./tools/alias-hook.cjs tools/watermark-check/build/tools/watermark-check/check-watermark.js",
    "check:templates": "tsc -p tools/templates-check/tsconfig.json && node -r ./tools/alias-hook.cjs tools/templates-check/build/tools/templates-check/check-templates.js",
    "check:storage": "node tools/storage-check/listing-lockdown-check.js",
    "check:distribution": "npm run check:distribution:contract && npm run check:distribution:export",
    "check:distribution:network": "node tools/distribution-check/distribution-check.js",
    "check:distribution:sql": "node tools/distribution-check/check-transactions.cjs",
    "check:distribution:export": "node tools/distribution-check/check-export.cjs",
    "check:distribution:browser": "node tools/distribution-check/check-browser.cjs",
    "test:pawapay": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/test_pawapay.ts",
    "check:pawapay-token": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/check_pawapay_token.ts",
    "check:pawapay-countries": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/check_pawapay_countries.ts",
    "check:payments": "tsc -p tools/payments-check/tsconfig.json && node tools/payments-check/build/tools/payments-check/check-countries.js",
    "check:distribution:contract": "tsc -p tools/distribution-check/tsconfig.json && node tools/distribution-check/build/tools/distribution-check/check-contract.js",
    "check:topup": "tsc -p tools/topup-check/tsconfig.json && node tools/topup-check/build/tools/topup-check/check-topup.js",
    "check:webhook": "tsc -p tools/webhook-check/tsconfig.json && node tools/webhook-check/build/tools/webhook-check/check-webhook.js",
    "check:clone": "tsc -p tools/clone-check/tsconfig.json && node tools/clone-check/build/tools/clone-check/check-clone.js",
    "check:frame-render": "tsc -p tools/frame-render-check/tsconfig.json && node tools/frame-render-check/run.js",
    "check:free-limit": "node tools/free-limit-check/check-free-limit.cjs",
    "check:render-server": "tsc -p tools/server-render-spike/tsconfig.json && node -r ./tools/alias-hook.cjs tools/server-render-spike/build/tools/server-render-spike/spike.js",
    "check:watermark-pass": "tsc -p tools/watermark-pass-check/tsconfig.json && node -r ./tools/alias-hook.cjs tools/watermark-pass-check/build/tools/watermark-pass-check/check-watermark-pass.js && node tools/watermark-pass-check/check-pass-sql.cjs",
    "check:upsell": "node tools/watermark-upsell-check/check-upsell.cjs",
    "check:admin": "tsc -p tools/admin-check/tsconfig.json && node -r ./tools/alias-hook.cjs tools/admin-check/build/tools/admin-check/check-admin.js && node tools/admin-check/check-admin-sql.cjs",
    "check:ui-tarifs": "node tools/tarifs-check/check-ui-tarifs.cjs",
    "check:ui-tarifs:rendu": "npm run build && node tools/tarifs-check/check-rendu-tarifs.cjs",
    "check:ui-tarifs:selecteur": "node tools/tarifs-check/check-selecteur-duree.cjs",
    "capture:ui-tarifs": "node tools/tarifs-check/capture-tarifs.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "fabric": "^7.4.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.27",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2"
  }
}
