{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "rootDir": "../..",
    "outDir": "build",
    /* Alias `@/` : résolu à l'exécution par `tools/alias-hook.cjs`. */
    "baseUrl": "../..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "files": ["check-geometry.ts"]
}
