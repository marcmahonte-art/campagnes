{
  "compilerOptions": {
    "target": "ES2022",
    /*
     * `DOM` est nécessaire : `lib/cutout.ts` déclare `cutoutPhoto()`, qui
     * manipule `HTMLCanvasElement`, `Image` et `navigator.gpu`. Le harnais ne
     * l'appelle pas — il n'y a pas de navigateur ici — mais le module doit se
     * typer.
     */
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "rootDir": "../..",
    "outDir": "build"
  },
  "files": ["check-cutout.ts"]
}
