{
  "compilerOptions": {
    "target": "ES2022",
    /*
     * `DOM` est nécessaire : `lib/participant.ts` déclare `readPhotoFile()`, qui
     * utilise `FileReader` et `window.Image`. Le harnais ne les appelle pas, mais
     * le module doit se typer. Sans cette lib, `tsc` échouait sur deux noms
     * introuvables — et comme `noEmitOnError` est à `false`, il émettait quand
     * même, donc le contrôle tournait sans avoir été compilé proprement.
     */
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "rootDir": "../..",
    "outDir": "build"
  },
  "files": ["check-participant.ts"]
}