# ---------------------------------------------------------------------
# Campagnes — variables d'environnement
#
# Renseignez ces deux valeurs pour activer le mode Supabase
# (Auth réelle + Postgres + RLS + Storage).
#
# Si elles sont absentes, l'application démarre en MODE LOCAL DE DÉMONSTRATION :
# mêmes écrans, mêmes parcours, persistance dans le navigateur (localStorage).
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Utilisée uniquement côté serveur (route /auth/callback) — ne pas exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique, pour construire les liens de campagne et de profil.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# PawaPay (Merchant API v2) — Paiements Mobile Money
# ---------------------------------------------------------------------
# Token généré dans le Dashboard PawaPay (Sandbox ou Production)
PAWAPAY_API_TOKEN=

# OBLIGATOIRE en production : sans cette variable, le build échoue.
# Sandbox : https://api.sandbox.pawapay.io
# Production : https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# Refuser les callbacks pawaPay non signés.
# Par défaut : exigé dès que NODE_ENV = production. Ne mettez `false` que le
# temps d'activer les « signed callbacks » dans le Dashboard PawaPay.
# PAWAPAY_REQUIRE_SIGNED_CALLBACKS=true

# Jeton du cron d'expiration des abonnements (/api/cron/expire-plans).
# Vercel pose déjà l'en-tête x-vercel-cron de son côté ; cette variable sert
# surtout à déclencher la tâche à la main. Si elle est absente en production,
# la route refuse tout appel.
# CRON_SECRET=
