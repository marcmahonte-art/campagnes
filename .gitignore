node_modules/
.next/
.next-distribution/
.next.stale/
.next.*/
out/
build/
dist/
dev.log

.env
.env.local
.env*.local

*.tsbuildinfo
next-env.d.ts

# Cache local de la CLI Supabase (créé par `npx supabase`), hors dépôt.
supabase/.temp/

.DS_Store
Thumbs.db

# Fichiers de verrou Office (~$...) : crees a l'ouverture d'un document, jamais
# des documents.
~$*

.vercel
*.log
npm-debug.log*

# Données internes de l'assistant (notes de projet, mémoire) — hors dépôt.
.workbuddy-ai/

# Assets de travail du designer (lourds, hors dépôt)
*.ai
docs/**/*.png
docs/**/*.PNG
docs/**/*.jpg
docs/**/*.jpeg

# Captures de vérification de l'interface participant : elles documentent un
# écart mesuré maquette ↔ rendu réel, on les versionne donc explicitement.
!docs/participant/captures/*.png

# Documents de travail du SIAO : PDF, archives de polices, échantillonnages.
# Le dépôt suit le code, pas les brouillons de production — ces fichiers
# pèsent plusieurs dizaines de Mo et n'ont pas leur place dans un historique.
docs/siao/
docs/echantillon/

# Sources de design de la bulle promo (EPS, AI, PDF) : brouillons de production
# de plusieurs dizaines de Mo, sans rapport avec le code. Le rendu retenu vit
# dans le composant ; ces fichiers ne sont pas des livrables.
docs/participant/promo/

# Archives de polices : volumineuses, régénérables depuis leur source.
*.zip

# Captures de vérification produites par `tools/premium-check/` : ce sont des
# preuves locales de mesure (largeurs d'écran), pas des livrables — on les
# régénère à la demande au lieu de les suivre.
.premium-shots/

# Rendus HTML de contrôle (dump de page produit par les outils headless) : sortie
# intermédiaire de diagnostic, jamais servie ni référencée.
pr2.html
premium-render.html

# Photo factice déposée par `tools/watermark-check/runtime-check.js` pour
# déclencher l'affichage réel du bandeau. Régénérable, pas un livrable.
tools/watermark-check/.tmp/

# Captures produites par `tools/header-check/` : preuves locales de mesure,
# régénérées à la demande.
tools/header-check/.tmp/

# Charges utiles SQL et dumps de page fabriqués pour appliquer/vérifier une
# migration. Sortie intermédiaire de diagnostic, jamais servie.
.tmp-mig/

# Répertoires de diagnostic à la racine (mesures réseau, pages capturées,
# profils de navigateur). Intermédiaires, volumineux (jusqu'à 80 Mo), et
# reproductibles — aucun ne doit entrer dans l'historique.
.tmp-measure/
.tmp-net/
.tmp-p4/

# Jeton témoin de `tools/distribution-check/` : c'est un secret d'accès réel à
# une campagne. Il ne doit JAMAIS entrer dans l'historique — le fichier
# n'existe que le temps d'un contrôle d'étanchéité de la RLS.
tools/distribution-check/.witness

# Matériel de référence téléchargé depuis des sites tiers (bundles JS, CSS,
# archives, images) : ce n'est pas du code du projet, seulement des brouillons
# de veille. Seul le livrable rédigé (`docs/monétisation/ui/audit-ui-tarifs.md`)
# est versionné.
docs/**/*.téléchargement
docs/**/*_files/

# Captures de vérification de l'audit d'interface : livrables de mesure, suivis
# volontairement (forcés par `git add -f`), donc pas concernés par la règle
# `docs/**/*.png` ci-dessus.
!docs/monétisation/ui/captures/*.png

# Profils Chrome et gros plans produits par les sondes `tools/tarifs-check/` :
# régénérables à la demande, jamais des livrables. Les captures retenues
# sont dans `docs/monetisation/ui/captures/`.
tools/tarifs-check/.tmp/

# Profils Chrome des sondes de parcours participant : recréés à chaque
# exécution, sans valeur, et jamais des livrables.
tools/participant-ui-check/.tmp/
tools/watermark-upsell-check/.tmp/
tools/cutout-journey-check/.tmp/
tools/.u1-crops/

# Profils Chrome laissés par les sondes headless (.u1-chrome-profile*) :
# volumineux et sans valeur. Les captures retenues sont versionnées
# dans `docs/monetisation/ui/captures/`.
.u1-chrome-profile*/

# Profils Chrome de `tools/participant-ui-check/` : un port et un dossier uniques
# à chaque exécution, donc jamais les mêmes deux fois — impossible à suivre,
# et inutile puisqu'on les régénère à chaque lancement.
tools/participant-ui-check/.tmp/
